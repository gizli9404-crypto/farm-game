    <script>
        let secretKey = "";

        function checkAuth() {
            secretKey = document.getElementById('secret-input').value.trim();
            fetch(`/api/admin/users?secret=${secretKey}`)
                .then(res => {
                    if(res.status === 200) {
                        document.getElementById('auth-screen').classList.add('hidden');
                        document.getElementById('admin-dashboard').classList.remove('hidden');
                        loadAdminData();
                        setInterval(loadAdminData, 5000);
                    } else { alert("Hatalı Şifre!"); }
                });
        }

        function loadAdminData() {
            if(!secretKey) return;
            
            fetch(`/api/admin/users?secret=${secretKey}`)
                .then(res => res.json())
                .then(data => {
                    let tbody = document.getElementById('users-table-body');
                    tbody.innerHTML = "";
                    data.forEach(u => {
                        tbody.innerHTML += `<tr class="hover:bg-slate-800/40"><td class="p-2"><b>@${u.username || 'Anonim'}</b><br><span class="text-[9px] text-slate-500">${u.user_id}</span></td><td class="p-2 text-emerald-400 font-bold">${u.balance} PEPE</td></tr>`;
                    });
                });

            fetch(`/api/admin/withdrawals?secret=${secretKey}`)
                .then(res => res.json())
                .then(data => {
                    let tbody = document.getElementById('withdrawals-table-body');
                    tbody.innerHTML = "";
                    data.forEach(w => {
                        tbody.innerHTML += `<tr class="hover:bg-slate-800/40"><td class="p-2">@${w.username}</td><td class="p-2 text-emerald-400 font-bold">${w.amount} PEPE</td></tr>`;
                    });
                });

            fetch(`/api/admin/logs?secret=${secretKey}`)
                .then(res => res.json())
                .then(logs => {
                    let logContainer = document.getElementById('live-logs-container');
                    logContainer.innerHTML = "";
                    logs.forEach(l => {
                        logContainer.innerHTML += `
                            <div class="bg-slate-950/80 p-2 rounded border border-slate-800/80 space-y-1">
                                <div class="flex justify-between text-[10px] text-slate-400">
                                    <span class="text-emerald-400 font-bold">@${l.username}</span>
                                    <span>${l.timestamp}</span>
                                </div>
                                <div class="text-white text-[11px] font-sans"><b>[${l.action}]</b> ${l.details}</div>
                            </div>
                        `;
                    });
                }).catch(e => {});
        }

        function updateUserBalance() {
            let user_id = document.getElementById('target-user-id').value.trim();
            let amount = parseFloat(document.getElementById('balance-amount').value);
            let action = document.getElementById('balance-action').value;

            fetch('/api/admin/update_balance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ secret: secretKey, user_id, amount, action })
            }).then(res => res.json()).then(data => {
                alert(data.success ? "Bakiye başarıyla güncellendi!" : "Hata: " + data.error);
                loadAdminData();
            });
        }

        function sendBroadcast() {
            let message = document.getElementById('broadcast-msg').value.trim();
            if(!message) return;
            alert("Duyuru gönderildi!");
        }
    </script>
</body>
</html>
