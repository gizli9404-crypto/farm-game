        <button onclick="switchTab('rank'); fetchLeaderboard();" class="nav-btn text-slate-400 flex flex-col items-center"><i class="fa-solid fa-trophy text-xs"></i><span class="text-[9px]">RANK</span></button>
        <button onclick="switchTab('wallet')" class="nav-btn text-slate-400 flex flex-col items-center"><i class="fa-solid fa-wallet text-xs"></i><span class="text-[9px]">WALLET</span></button>
    </nav>

    <script>
        let gameState = { balance: 0.00, tickets: 0, wallet: "" };
        let telegramId = "user_" + Math.floor(Math.random() * 1000000); 
        let username = "MiniAppUser";

        const tg = window.Telegram?.WebApp;
        if (tg && tg.initDataUnsafe?.user?.id) {
            telegramId = tg.initDataUnsafe.user.id.toString();
            username = tg.initDataUnsafe.user.username || "TelegramUser";
        }

        function sendActivityLog(actionType, details) {
            fetch('/api/user/log', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ telegram_id: telegramId, username, action: actionType, details, timestamp: new Date().toLocaleTimeString() })
            }).catch(() => {});
        }

        function syncToDatabase() {
            fetch('/api/user/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ telegram_id: telegramId, username, balance: gameState.balance, tickets: gameState.tickets, wallet: gameState.wallet })
            }).catch(() => {});
        }

        function fetchUserData() {
            fetch(`/api/user/${telegramId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.balance !== undefined) {
                        gameState.balance = data.balance;
                        gameState.tickets = data.tickets;
                        gameState.wallet = data.wallet || "";
                        updateUI();
                    }
                }).catch(() => {});
        }

        function fetchLeaderboard() {
            fetch('/api/leaderboard')
                .then(res => res.json())
                .then(data => {
                    let listEl = document.getElementById('leaderboard-list');
                    if (!data || data.length === 0) return;
                    let html = '';
                    data.forEach((user, index) => {
                        html += `
                            <div class="flex justify-between items-center bg-slate-900 p-2.5 rounded-xl border border-slate-800">
                                <span class="text-white font-bold">#${index + 1} @${user.username}</span>
                                <span class="text-emerald-400 font-black">${Number(user.balance).toFixed(2)} PEPE</span>
                            </div>
                        `;
                    });
                    listEl.innerHTML = html;
                }).catch(() => {});
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.getElementById('tab-' + tabId).classList.add('active');
        }

        function updateUI() {
            document.getElementById('balance').innerText = gameState.balance.toFixed(4);
            document.getElementById('ticket-count').innerText = gameState.tickets + " Biletiniz Var";
            let progressPercent = Math.min((gameState.balance / 5000) * 100, 100);
            document.getElementById('progress-bar').style.width = progressPercent + '%';
        }

        function watchAdTask() {
            gameState.tickets += 1;
            syncToDatabase();
            updateUI();
            sendActivityLog("AD_WATCH", "Reklam izlendi, +1 bilet eklendi.");
            alert("Başarılı! +1 bilet eklendi.");
        }

        let currentRotation = 0;
        function spinWheel() {
            if (gameState.tickets < 1) { alert("Yeterli biletiniz yok!"); return; }
            gameState.tickets -= 1;
            let prizes = [50, 0, 250, 1000, 0, 100];
            let prize = prizes[Math.floor(Math.random() * prizes.length)];
            currentRotation += 1800 + Math.random() * 360;
            document.getElementById('svg-wheel').style.transform = `rotate(${currentRotation}deg)`;

            setTimeout(() => {
                if (prize > 0) {
                    gameState.balance += prize;
                    sendActivityLog("SPIN_WIN", `Çarktan ${prize} PEPE kazandı.`);
                    if (typeof confetti === 'function') confetti({ particleCount: 50 });
                    alert(`Tebrikler! ${prize} PEPE kazandınız!`);
                } else {
                    sendActivityLog("SPIN_EMPTY", "Çevirdi ancak ödül çıkmadı.");
                    alert("Maalesef boş çıktı.");
                }
                syncToDatabase();
                updateUI();
            }, 5000);
        }

        function requestWithdraw() {
            let addr = document.getElementById('wallet-addr').value.trim();
            let amount = parseFloat(document.getElementById('withdraw-amount').value);
            if (!addr || amount < 5000 || gameState.balance < amount) {
                alert("Geçersiz cüzdan veya yetersiz bakiye (Min: 5000 PEPE).");
                return;
            }
            gameState.balance -= amount;
            gameState.wallet = addr;
            syncToDatabase();
            updateUI();
            fetch('/api/withdraw', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: telegramId, amount, wallet: addr })
            });
            alert("Çekim talebiniz başarıyla alındı!");
        }

        function toggleTheme() { document.body.classList.toggle('light-theme'); }

        window.onload = function() {
            fetchUserData();
            fetchLeaderboard();
        };
    </script>
</body>
</html>
