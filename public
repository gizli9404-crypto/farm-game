        <div class="glass-panel w-full max-w-xs rounded-3xl p-6 text-center space-y-4 border border-slate-700/80 shadow-2xl">
            <div id="modal-icon" class="w-12 h-12 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto text-xl border border-emerald-500/30 shadow-inner">
                <i class="fa-solid fa-check"></i>
            </div>
            <div>
                <h3 id="modal-title" class="font-black text-white light-theme:text-slate-900 text-base">Bilgilendirme</h3>
                <p id="modal-desc" class="text-xs text-slate-300 light-theme:text-slate-700 mt-1.5 leading-relaxed">İşlem tamamlandı.</p>
            </div>
            <button onclick="closeModal(); playClickSound();" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black py-2.5 rounded-xl text-xs transition-all cursor-pointer shadow-md">Tamam</button>
        </div>
    </div>

    <!-- ALT NAVİGASYON -->
    <nav class="absolute bottom-0 left-0 right-0 glass-panel border-t border-slate-800/80 flex justify-around p-2.5 z-40 backdrop-blur-xl">
        <button onclick="switchTab('home'); playClickSound();" class="nav-btn text-slate-400 light-theme:text-slate-600 flex flex-col items-center space-y-0.5 cursor-pointer transition-colors" data-target="home"><i class="fa-solid fa-house text-xs"></i><span class="text-[9px] font-bold">HOME</span></button>
        <button onclick="switchTab('spin'); playClickSound();" class="nav-btn text-emerald-400 flex flex-col items-center space-y-0.5 cursor-pointer transition-colors" data-target="spin"><i class="fa-solid fa-slot-machine text-xs"></i><span class="text-[9px] font-bold">SPIN</span></button>
        <button onclick="switchTab('shop'); playClickSound();" class="nav-btn text-slate-400 light-theme:text-slate-600 flex flex-col items-center space-y-0.5 cursor-pointer transition-colors" data-target="shop"><i class="fa-solid fa-star text-xs"></i><span class="text-[9px] font-bold">SHOP</span></button>
        <button onclick="switchTab('invite'); playClickSound();" class="nav-btn text-slate-400 light-theme:text-slate-600 flex flex-col items-center space-y-0.5 cursor-pointer transition-colors" data-target="invite"><i class="fa-solid fa-globe text-xs"></i><span class="text-[9px] font-bold">INVITE</span></button>
        <button onclick="switchTab('rank'); playClickSound();" class="nav-btn text-slate-400 light-theme:text-slate-600 flex flex-col items-center space-y-0.5 cursor-pointer transition-colors" data-target="rank"><i class="fa-solid fa-trophy text-xs"></i><span class="text-[9px] font-bold">RANK</span></button>
    </nav>

    <script>
        let gameState = { balance: 150.00, tickets: 2 };
        let currentRotation = 0;
        let isSpinning = false;

        // Telegram WebApp entegrasyonu başlatma
        const tg = window.Telegram?.WebApp;
        if (tg) {
            tg.expand();
        }

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        function playSound(type) {
            if (!audioCtx) return;
            if (audioCtx.state === 'suspended') { audioCtx.resume(); }
            
            let osc = audioCtx.createOscillator();
            let gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            let now = audioCtx.currentTime;

            if (type === 'click') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, now);
                osc.frequency.exponentialRampToValueAtTime(800, now + 0.05);
                gain.gain.setValueAtTime(0.05, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.05);
                osc.start(now);
                osc.stop(now + 0.05);
            } else if (type === 'win') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(300, now);
                osc.frequency.setValueAtTime(500, now + 0.1);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
            } else if (type === 'jackpot') {
                osc.type = 'square';
                osc.frequency.setValueAtTime(250, now);
                osc.frequency.setValueAtTime(450, now + 0.15);
                osc.frequency.setValueAtTime(650, now + 0.3);
                gain.gain.setValueAtTime(0.12, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.7);
                osc.start(now);
                osc.stop(now + 0.7);
            } else if (type === 'error') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, now);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.3);
                osc.start(now);
                osc.stop(now + 0.3);
            }
        }

        function playClickSound() { playSound('click'); }

        function toggleTheme() {
            let body = document.body;
            let icon = document.getElementById('theme-icon');
            body.classList.toggle('light-theme');
            if(body.classList.contains('light-theme')) {
                icon.className = "fa-solid fa-sun";
            } else {
                icon.className = "fa-solid fa-moon";
            }
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.getElementById('tab-' + tabId).classList.add('active');
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-emerald-400');
                btn.classList.add('text-slate-400', 'light-theme:text-slate-600');
                if(btn.getAttribute('data-target') === tabId) {
                    btn.classList.remove('text-slate-400', 'light-theme:text-slate-600');
                    btn.classList.add('text-emerald-400');
                }
            });
        }

        function showModal(title, desc, isJackpot = false, isError = false) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-desc').innerText = desc;
            let iconDiv = document.getElementById('modal-icon');
            
            if(isJackpot) {
                iconDiv.className = "w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center mx-auto text-xl border border-amber-500/30 shadow-inner";
                iconDiv.innerHTML = '<i class="fa-solid fa-trophy"></i>';
                playSound('jackpot');
                confetti({ particleCount: 150, spread: 90, origin: { y: 0.6 } });
            } else if(isError) {
                iconDiv.className = "w-12 h-12 rounded-2xl bg-rose-500/20 text-rose-400 flex items-center justify-center mx-auto text-xl border border-rose-500/30 shadow-inner";
                iconDiv.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
                playSound('error');
            } else {
                iconDiv.className = "w-12 h-12 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto text-xl border border-emerald-500/30 shadow-inner";
                iconDiv.innerHTML = '<i class="fa-solid fa-check"></i>';
                playSound('win');
            }
            document.getElementById('custom-modal').classList.add('flex');
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
            document.getElementById('custom-modal').classList.remove('flex');
        }

        function updateUI() {
            document.getElementById('balance').innerText = gameState.balance.toFixed(4);
            document.getElementById('ticket-count').innerText = `${gameState.tickets} Biletiniz Var`;
            document.getElementById('rank-balance').innerText = Math.floor(gameState.balance) + " PEPE";
            let percentage = Math.min((gameState.balance / 5000) * 100, 100);
            document.getElementById('progress-bar').style.width = percentage + '%';
            document.getElementById('progress-text').innerText = `${gameState.balance.toFixed(2)} / 5,000 PEPE (${percentage.toFixed(1)}%)`;
        }

        function copyRefLink() {
            let copyText = document.getElementById("ref-link");
            navigator.clipboard.writeText(copyText.value);
            showModal("Başarılı 📋", "Özel davet bağlantınız panoya kopyalandı!");
        }

        function shareViaTelegram() {
            let refUrl = document.getElementById("ref-link").value;
            let shareText = "🚀 Sanal Miner Pro'ya katıl, birlikte PEPE ve TON kazanalım! Hemen tıkla:";
            
            // Telegram yerleşik paylaşım tetikleyicisi
            if (tg && tg.openTelegramLink) {
                tg.openTelegramLink(`https://t.me/share/url?url=${encodeURIComponent(refUrl)}&text=${encodeURIComponent(shareText)}`);
            } else {
                window.open(`https://t.me/share/url?url=${encodeURIComponent(refUrl)}&text=${encodeURIComponent(shareText)}`, '_blank');
            }
        }

        function watchAdTask(amount, counterId, limit) {
            let countEl = document.getElementById(counterId);
            let currentCount = parseInt(countEl.innerText);
            if (currentCount >= limit) {
                showModal("Günlük Limit", "Bu sağlayıcı için günlük izleme sınırına ulaştınız.", false, true);
                return;
            }
            countEl.innerText = currentCount + 1;
            gameState.tickets += amount;
            updateUI();
            showModal("Tebrikler! 🎟️", `Reklam izlendi, hesabınıza +${amount} Bilet eklendi.`);
        }

        function spinWheel() {
            if (isSpinning) return;
            if (gameState.tickets <= 0) {
                showModal("Biletiniz Kalmadı", "Çevirim yapmak için reklam izleyerek bilet kazanmalısınız.", false, true);
                return;
            }

            isSpinning = true;
            let spinBtn = document.getElementById('spin-btn');
            spinBtn.classList.add('opacity-50', 'cursor-not-allowed');

            gameState.tickets -= 1;
            updateUI();

            let wheel = document.getElementById('svg-wheel');
            let rand = Math.random() * 100;
            let targetCenterAngle = 0;
            let prizeWon = 0;
            let prizeText = "";
            let isJackpot = false;

            if (rand < 35) {
                targetCenterAngle = 330; prizeWon = 50; prizeText = "Çarktan 50 PEPE kazandınız!";
            } else if (rand < 65) {
                targetCenterAngle = Math.random() < 0.5 ? 90 : 270; prizeWon = 0; prizeText = "Üzgünüm, bu çevirmede ödül çıkmadı (BOŞ)!";
            } else if (rand < 85) {
                targetCenterAngle = 30; prizeWon = 100; prizeText = "Çarktan 100 PEPE kazandınız!";
            } else if (rand < 95) {
                targetCenterAngle = 150; prizeWon = 250; prizeText = "Çarktan 250 PEPE kazandınız!";
            } else {
                targetCenterAngle = 210; prizeWon = 1000; prizeText = "MUHTEŞEM! Büyük İkramiye 1000 PEPE Kazandınız! 🏆"; isJackpot = true;
            }

            let extraSpins = 360 * 6;
            currentRotation = extraSpins + (360 - targetCenterAngle);
            wheel.style.transform = `rotate(${currentRotation}deg)`;

            setTimeout(() => {
                if (prizeWon > 0) {
                    gameState.balance += prizeWon;
                    showModal("Ödül Kazandınız! 🎰", prizeText, isJackpot);
                } else {
                    showModal("Şansınızı Deneyin", prizeText, false, true);
                }
                updateUI();
                isSpinning = false;
                spinBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }, 5000);
        }

        function requestWithdraw() {
            let addr = document.getElementById('wallet-addr').value.trim();
            let amount = parseFloat(document.getElementById('withdraw-amount').value);
            let network = document.getElementById('wallet-network').value;

            if (addr.length < 10) {
                showModal("Geçersiz Adres", "Lütfen geçerli bir cüzdan adresi giriniz.", false, true);
                return;
            }
            if (amount < 5000) {
                showModal("Limit Hatası", "Minimum çekim miktarı 5000 PEPE'dir.", false, true);
                return;
            }
            if (gameState.balance < amount) {
                showModal("Yetersiz Bakiye", "Çekim için bakiyeniz henüz yeterli değil.", false, true);
                return;
            }

            gameState.balance -= amount;
            updateUI();
            showModal("Bot Worker Başlatıldı 🤖", `Çekim talebiniz (${network}) Telegram bot worker kuyruğuna aktarıldı.`);

            let liveList = document.getElementById('live-withdrawals');
            let shortAddr = addr.substring(0, 4) + "..." + addr.substring(addr.length - 4);
            let newItem = document.createElement('div');
            newItem.className = "flex justify-between items-center bg-slate-950/60 light-theme:bg-slate-200 p-2 rounded-xl border border-slate-800/60 animate-fade";
            newItem.innerHTML = `<span class="text-slate-300 light-theme:text-slate-800 font-medium">${shortAddr} (${amount} PEPE)</span><span class="text-amber-400 font-bold bg-amber-500/10 px-2 py-0.5 rounded text-[10px]">Bot İşliyor ⏳</span>`;
            liveList.prepend(newItem);
        }

        updateUI();
    </script>
</body>
</html>
