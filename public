            </div>
        </div>

        <!-- 2. SEKME: SPIN (GELİŞMİŞ ÖZEL ÇARK & CANLI AKIŞ ŞERİDİ) -->
        <div id="tab-spin" class="tab-content flex-col items-center space-y-2">
            <!-- Anlık Kazananlar Kayan Şeridi -->
            <div class="w-full bg-slate-900/80 light-theme:bg-slate-200 border border-slate-800 rounded-xl p-1.5 text-[10px] text-emerald-400 flex items-center space-x-2 overflow-hidden whitespace-nowrap">
                <i class="fa-solid fa-bullhorn text-amber-400 ml-1"></i>
                <span id="ticker-winners" class="font-medium animate-pulse">CryptoKing_77 çarktan 1,000 PEPE kazandı! | TonMaster99 250 PEPE kazandı!</span>
            </div>

            <div class="relative w-56 h-56 flex items-center justify-center my-1 wheel-glow">
                <!-- Üst İşaretçi -->
                <div class="absolute -top-3 z-30 text-amber-400 text-2xl filter drop-shadow-[0_3px_6px_rgba(0,0,0,0.9)] animate-bounce">
                    <i class="fa-solid fa-caret-down"></i>
                </div>
                <!-- Çark Çerçevesi ve SVG -->
                <div class="w-52 h-52 rounded-full p-1.5 bg-gradient-to-tr from-slate-900 via-emerald-500/40 to-amber-500/50 shadow-2xl flex items-center justify-center relative">
                    <svg id="svg-wheel" class="w-full h-full rounded-full overflow-hidden shadow-inner" viewBox="0 0 100 100">
                        <!-- Dilimler -->
                        <path d="M50 50 L50 3 A47 47 0 0 1 90.7 26.5 Z" fill="#0369a1" stroke="#0f172a" stroke-width="1.5"/>
                        <path d="M50 50 L90.7 26.5 A47 47 0 0 1 90.7 73.5 Z" fill="#1e293b" stroke="#0f172a" stroke-width="1.5"/>
                        <path d="M50 50 L90.7 73.5 A47 47 0 0 1 50 97 Z" fill="#6d28d9" stroke="#0f172a" stroke-width="1.5"/>
                        <path d="M50 50 L50 97 A47 47 0 0 1 9.3 73.5 Z" fill="#b45309" stroke="#0f172a" stroke-width="1.5"/>
                        <path d="M50 50 L9.3 73.5 A47 47 0 0 1 9.3 26.5 Z" fill="#1e293b" stroke="#0f172a" stroke-width="1.5"/>
                        <path d="M50 50 L9.3 26.5 A47 47 0 0 1 50 3 Z" fill="#047857" stroke="#0f172a" stroke-width="1.5"/>
                        <!-- Metinler -->
                        <g font-size="6" font-weight="900" text-anchor="middle" dominant-baseline="middle">
                            <text x="73" y="27" fill="#e0f2fe">50 PEPE</text>
                            <text x="78" y="53" fill="#94a3b8">BOŞ</text>
                            <text x="65" y="80" fill="#f3e8ff">250 PEPE</text>
                            <text x="35" y="80" fill="#fef08a">1000 🏆</text>
                            <text x="22" y="53" fill="#94a3b8">BOŞ</text>
                            <text x="30" y="27" fill="#ecfdf5">100 PEPE</text>
                        </g>
                    </svg>
                    <!-- Orta Taş -->
                    <div class="absolute w-10 h-10 bg-slate-950 rounded-full border-2 border-amber-400 z-20 shadow-2xl flex items-center justify-center text-amber-400 text-xs">
                        <i class="fa-solid fa-gem animate-pulse"></i>
                    </div>
                </div>
            </div>
            
            <div class="text-center">
                <span id="ticket-count" class="text-xs font-black text-emerald-400 tracking-wide">2 Biletiniz Var</span>
                <p class="text-[9px] text-slate-400 light-theme:text-slate-600 mt-0.5">Ses efektli ve hızlı tıklama korumalı çark motoru.</p>
            </div>

            <div class="w-full max-w-xs space-y-2">
                <button onclick="switchTab('home'); playClickSound();" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:opacity-90 text-slate-950 font-black py-2 rounded-xl text-xs transition-all shadow-lg shadow-emerald-500/20 cursor-pointer flex items-center justify-center">
                    <i class="fa-solid fa-play mr-2"></i> REKLAM İZLE & BİLET KAZAN
                </button>
                <button id="spin-btn" onclick="spinWheel()" class="w-full bg-slate-800/90 light-theme:bg-slate-200 hover:bg-slate-700 text-slate-200 light-theme:text-slate-800 font-bold py-2 rounded-xl text-xs transition-all border border-slate-700/80 cursor-pointer shadow flex items-center justify-center">
                    <i class="fa-solid fa-dharmachakra mr-2 text-amber-400"></i> Çarkı Çevir (1 Bilet Harca)
                </button>
            </div>
        </div>

        <!-- 3. SEKME: SHOP -->
        <div id="tab-shop" class="tab-content flex-col space-y-3">
            <h2 class="text-base font-black text-white light-theme:text-slate-900">Mağaza & VIP Bot</h2>
            <div class="glass-card p-3.5 rounded-2xl space-y-2 border-slate-800/80 text-xs text-slate-300">
                <div class="font-bold text-white light-theme:text-slate-900">Otomatik AdsGram & Bot Worker Modülü</div>
                <p>Şirket onayından sonra reklam ID'leriniz buraya entegre edilerek tüm gelirler otomatik olarak hesaplara işlenecektir.</p>
            </div>
        </div>

        <!-- 4. SEKME: INVITE (GERÇEK TELEGRAM DAVET SİSTEMİ) -->
        <div id="tab-invite" class="tab-content flex-col space-y-3">
            <div class="flex justify-between items-center">
                <h2 class="text-base font-black text-white light-theme:text-slate-900">Arkadaşını Davet Et</h2>
                <span class="text-[10px] bg-emerald-500/10 text-emerald-400 font-bold px-2.5 py-1 rounded-full border border-emerald-500/20">🎁 Her Davete +2 Bilet</span>
            </div>
            
            <!-- Telegram Paylaşım Kutusu -->
            <div class="glass-card p-4 rounded-2xl space-y-3 border-slate-800/80 shadow-lg">
                <div class="text-xs text-slate-300 leading-relaxed">
                    Telegram üzerinden arkadaşlarına doğrudan davet gönder. Arkadaşın bota katıldığı anda hesabına anında bilet tanımlanır.
                </div>
                <button onclick="shareViaTelegram(); playClickSound();" class="w-full bg-gradient-to-r from-sky-400 to-blue-600 hover:opacity-90 text-white font-black py-3 rounded-xl text-xs shadow-lg cursor-pointer transition-all flex items-center justify-center">
                    <i class="fa-brands fa-telegram mr-2 text-base"></i> Telegram'da Arkadaş Davet Et
                </button>
                <div class="flex space-x-2 pt-1">
                    <input type="text" readonly id="ref-link" value="https://t.me/SanalMinerProBot?start=ref_98412" class="w-full bg-slate-950/90 light-theme:bg-slate-100 border border-slate-800 rounded-xl px-3 py-2 text-[11px] text-emerald-400 font-mono focus:outline-none">
                    <button onclick="copyRefLink(); playClickSound();" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-4 py-2 rounded-xl text-xs shadow transition-all cursor-pointer whitespace-nowrap"><i class="fa-solid fa-copy mr-1"></i> Kopyala</button>
                </div>
            </div>

            <!-- Adım Adım Davet Rehberi -->
            <div class="glass-card p-3.5 rounded-2xl space-y-2 border-slate-800/80">
                <div class="text-xs font-bold text-white light-theme:text-slate-900">Nasıl Çalışır?</div>
                <div class="space-y-1.5 text-[11px] text-slate-300">
                    <div class="flex items-center space-x-2">
                        <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-black text-[9px]">1</span>
                        <span>"Telegram'da Arkadaş Davet Et" butonuna tıkla.</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-black text-[9px]">2</span>
                        <span>Açılan Telegram ekranından arkadaşını seç ve gönder.</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-black text-[9px]">3</span>
                        <span>Arkadaşın botu başlattığında +2 bilet otomatik gelsin!</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. SEKME: RANK -->
        <div id="tab-rank" class="tab-content flex-col space-y-3">
            <div class="flex justify-between items-center">
                <h2 class="text-base font-black text-white light-theme:text-slate-900">Canlı Liderlik Tablosu</h2>
                <div class="flex items-center space-x-1.5 text-[10px] text-emerald-400 font-bold bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>Canlı Senkronize</span>
                </div>
            </div>
            
            <div class="glass-card p-3 rounded-2xl space-y-2 text-xs border-slate-800/80 shadow-lg">
                <div class="flex justify-between items-center bg-slate-900/80 light-theme:bg-slate-200 p-2.5 rounded-xl border border-slate-800">
                    <div class="flex items-center space-x-2">
                        <span class="text-amber-400 font-black">🥇</span>
                        <span class="text-white light-theme:text-slate-900 font-bold">CryptoKing_77</span>
                    </div>
                    <span class="text-emerald-400 font-black">34,500 PEPE</span>
                </div>
                <div class="flex justify-between items-center bg-slate-900/80 light-theme:bg-slate-200 p-2.5 rounded-xl border border-slate-800">
                    <div class="flex items-center space-x-2">
                        <span class="text-slate-300 light-theme:text-slate-700 font-black">🥈</span>
                        <span class="text-white light-theme:text-slate-900 font-bold">TonMaster99</span>
                    </div>
                    <span class="text-emerald-400 font-black">28,100 PEPE</span>
                </div>
                <div class="flex justify-between items-center bg-slate-900/80 light-theme:bg-slate-200 p-2.5 rounded-xl border border-slate-800">
                    <div class="flex items-center space-x-2">
                        <span class="text-amber-600 font-black">🥉</span>
                        <span class="text-white light-theme:text-slate-900 font-bold">AnadoluMiner</span>
                    </div>
                    <span class="text-emerald-400 font-black">19,400 PEPE</span>
                </div>

                <div class="flex justify-between items-center bg-emerald-500/10 p-3 rounded-xl border border-emerald-500/30 mt-2">
                    <div class="flex items-center space-x-2">
                        <span class="text-emerald-400 font-black">📍</span>
                        <span class="text-emerald-300 light-theme:text-emerald-700 font-bold">Siz (142. Sıra)</span>
                    </div>
                    <span id="rank-balance" class="text-emerald-400 font-black">150 PEPE</span>
                </div>
            </div>
        </div>

        <!-- CÜZDAN & OTOMATİK BOT ÇEKİM İŞLEMLERİ -->
        <div id="tab-wallet" class="tab-content flex-col space-y-3">
            <div class="flex justify-between items-center">
                <h2 class="text-base font-black text-white light-theme:text-slate-900">Cüzdan & Otomatik Bot Çekim</h2>
                <span class="text-[10px] bg-emerald-500/10 text-emerald-400 font-bold px-2 py-0.5 rounded-full border border-emerald-500/20">Bot Worker: Online 🟢</span>
            </div>
            
            <div class="glass-card p-4 rounded-2xl space-y-3 border-slate-800/80 shadow-lg">
                <div class="space-y-1">
                    <label class="text-[10px] text-slate-400 light-theme:text-slate-600 font-bold uppercase">Ağ / Cüzdan Tipi</label>
                    <select id="wallet-network" class="w-full bg-slate-950/90 border border-slate-800 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-emerald-500">
                        <option value="TON">TON Blockchain (Telegram Wallet / Tonkeeper)</option>
                        <option value="BEP20">Binance Smart Chain (BEP20)</option>
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] text-slate-400 light-theme:text-slate-600 font-bold uppercase">Cüzdan Adresi</label>
                    <input type="text" id="wallet-addr" placeholder="UQ... veya 0x..." class="w-full bg-slate-950/90 border border-slate-800 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-emerald-500">
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] text-slate-400 light-theme:text-slate-600 font-bold uppercase">Çekim Miktarı (Min: 5000 PEPE)</label>
                    <input type="number" id="withdraw-amount" value="5000" class="w-full bg-slate-950/90 border border-slate-800 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-emerald-500">
                </div>
                <button onclick="requestWithdraw(); playClickSound();" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 text-slate-950 font-black py-3 rounded-xl text-xs shadow cursor-pointer transition-all hover:opacity-90 flex items-center justify-center">
                    <i class="fa-solid fa-robot mr-1.5"></i> Telegram Bot ile Otomatik Çekim Yap
                </button>
            </div>

            <!-- Canlı Ödeme Akışı & Bot Logları -->
            <div class="glass-card p-3.5 rounded-2xl space-y-2.5 border-slate-800/80">
                <div class="flex justify-between items-center text-xs border-b border-slate-800/80 pb-2">
                    <span class="font-bold text-white light-theme:text-slate-900 flex items-center"><i class="fa-solid fa-terminal text-emerald-400 mr-1.5"></i> Bot Worker Log & Canlı Akış</span>
                    <span class="text-[10px] text-emerald-400 font-semibold animate-pulse">● Canlı</span>
                </div>
                <div id="live-withdrawals" class="space-y-2 text-[11px]">
                    <div class="flex justify-between items-center bg-slate-950/60 light-theme:bg-slate-200 p-2 rounded-xl border border-slate-800/60 animate-fade">
                        <span class="text-slate-300 light-theme:text-slate-800 font-medium">UQv2...81aF (5,000 PEPE)</span>
                        <span class="text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded text-[10px]">Bot Onayladı ✅</span>
