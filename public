<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sanal Miner Pro - Elite Ultimate Edition</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Konfeti Kütüphanesi -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        body { 
            background: linear-gradient(135deg, #030712 0%, #0f172a 100%); 
            color: #f8fafc; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            user-select: none; 
            transition: background 0.3s ease, color 0.3s ease;
        }
        body.light-theme {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            color: #0f172a;
        }
        body.light-theme .glass-panel {
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(0, 0, 0, 0.1);
        }
        body.light-theme .glass-card {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(0, 0, 0, 0.08);
            color: #0f172a;
        }
        body.light-theme .text-slate-300 { color: #334155 !important; }
        body.light-theme .text-slate-400 { color: #475569 !important; }
        body.light-theme .text-white { color: #020617 !important; }
        body.light-theme input, body.light-theme select {
            background: #ffffff !important;
            color: #0f172a !important;
            border-color: #cbd5e1 !important;
        }

        .tab-content { display: none; }
        .tab-content.active { display: flex; }
        
        .glass-panel { 
            background: rgba(15, 23, 42, 0.9); 
            backdrop-filter: blur(20px); 
            border: 1px solid rgba(255, 255, 255, 0.08); 
        }
        .glass-card { 
            background: rgba(30, 41, 59, 0.65); 
            border: 1px solid rgba(255, 255, 255, 0.06); 
        }
        
        #svg-wheel {
            transition: transform 5s cubic-bezier(0.15, 0.85, 0.05, 1);
            transform-origin: center;
        }

        @keyframes neon-pulse {
            0%, 100% { filter: drop-shadow(0 0 12px rgba(16, 185, 129, 0.3)); }
            50% { filter: drop-shadow(0 0 25px rgba(16, 185, 129, 0.6)); }
        }
        .wheel-glow { animation: neon-pulse 4s infinite ease-in-out; }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade { animation: fadeIn 0.3s ease-in-out forwards; }
    </style>
</head>
<body class="flex flex-col h-screen justify-between overflow-hidden">

    <!-- ÜST HEADER BÖLGESİ -->
    <header class="p-4 glass-panel border-b border-slate-800/80 z-20 space-y-3">
        <div class="flex justify-between items-center">
            <div class="flex bg-slate-950/90 light-theme:bg-slate-200 p-1 rounded-xl border border-slate-800/80 shadow-inner">
                <button onclick="playClickSound()" class="px-3.5 py-1.5 rounded-lg bg-emerald-500 text-slate-950 font-black text-xs shadow-md">PEPE</button>
                <button onclick="playClickSound()" class="px-3.5 py-1.5 rounded-lg text-slate-400 light-theme:text-slate-700 font-bold text-xs hover:text-white transition-colors">TON</button>
            </div>
            <div class="flex space-x-2 items-center">
                <button onclick="toggleTheme(); playClickSound();" class="text-xs bg-slate-800/80 light-theme:bg-slate-200 hover:bg-slate-700 text-amber-400 px-2.5 py-1.5 rounded-xl border border-slate-700/60 transition-all shadow" title="Tema Değiştir"><i class="fa-solid fa-moon" id="theme-icon"></i></button>
                <button onclick="switchTab('wallet'); playClickSound();" class="text-xs bg-slate-800/80 light-theme:bg-slate-200 hover:bg-slate-700 text-slate-200 light-theme:text-slate-800 px-3 py-1.5 rounded-xl font-bold border border-slate-700/60 transition-all shadow">Çekim</button>
                <button onclick="switchTab('invite'); playClickSound();" class="text-xs bg-gradient-to-r from-emerald-400 to-teal-500 text-slate-950 font-black px-3.5 py-1.5 rounded-xl shadow-lg shadow-emerald-500/20 transition-all"><i class="fa-solid fa-user-plus mr-1"></i> Davet Et</button>
            </div>
        </div>

        <!-- Bakiye Kartı -->
        <div class="glass-card p-3.5 rounded-2xl space-y-2.5 shadow-lg">
            <div class="flex justify-between items-center">
                <span class="text-[10px] text-slate-400 light-theme:text-slate-600 uppercase font-black tracking-wider flex items-center">
                    <i class="fa-solid fa-wallet text-emerald-400 mr-1.5"></i> Toplam Bakiyeniz
                </span>
                <span class="text-[10px] bg-emerald-500/10 text-emerald-400 font-bold px-2 py-0.5 rounded-full border border-emerald-500/20 flex items-center">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping mr-1"></span> Telegram Bot Worker: <b id="bot-status-text" class="ml-1">Online 🟢</b>
                </span>
            </div>
            <div class="flex items-baseline space-x-2">
                <span id="balance" class="text-2xl font-black text-white light-theme:text-slate-900 tracking-tight">150.0000</span>
                <span class="text-xs font-bold text-emerald-400">PEPE</span>
            </div>
            <div class="w-full bg-slate-950/90 light-theme:bg-slate-300 h-2 rounded-full overflow-hidden p-0.5 border border-slate-800/80">
                <div id="progress-bar" class="bg-gradient-to-r from-emerald-500 to-teal-400 h-full w-[3%] rounded-full transition-all duration-500 shadow-sm"></div>
            </div>
            <div class="flex justify-between text-[10px] text-slate-400 light-theme:text-slate-600 font-semibold">
                <span id="progress-text">150.00 / 5,000 PEPE (3.0%)</span>
                <span class="text-emerald-400 font-bold"><i class="fa-solid fa-shield-halved mr-1"></i>AdsGram Korumalı</span>
            </div>
        </div>
    </header>

    <!-- ANA İÇERİK ALANI -->
    <main class="flex-1 overflow-y-auto p-4 pb-24 flex flex-col justify-start">
        
        <!-- 1. SEKME: HOME (GÖREVLER) -->
        <div id="tab-home" class="tab-content flex-col space-y-3">
            <div class="flex space-x-4 border-b border-slate-800/80 pb-2">
                <span class="text-xs font-black text-emerald-400 border-b-2 border-emerald-400 pb-1 cursor-pointer">🎁 Ücretsiz Görevler</span>
                <span onclick="switchTab('spin'); playClickSound();" class="text-xs font-bold text-slate-400 light-theme:text-slate-600 pb-1 cursor-pointer hover:text-slate-200">📄 Şans Çarkı</span>
            </div>
            <div class="bg-slate-900/60 light-theme:bg-slate-200 p-3 rounded-2xl border border-slate-800/80 text-xs text-slate-300 light-theme:text-slate-700 leading-relaxed shadow-sm">
                📢 <b class="text-white light-theme:text-slate-900">AdsGram Entegrasyonu:</b> Reklam onay sürecinden sonra buradaki görevler otomatik API üzerinden ödüllendirecektir.
            </div>
            <div class="space-y-2.5">
                <div class="glass-card p-3.5 rounded-2xl flex items-center justify-between border-slate-800/80 shadow">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-black text-xs border border-emerald-500/20 shadow-inner">ADS</div>
                        <div>
                            <div class="text-xs font-bold text-white light-theme:text-slate-900">AdsGram Sponsorlu Reklam</div>
