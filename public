                    </div>
                    <button onclick="watchAdTask(1, 'ad1-count', 15); playClickSound();" class="bg-gradient-to-r from-emerald-500 to-teal-600 hover:opacity-90 text-slate-950 font-black px-4 py-2 rounded-xl text-xs shadow-md cursor-pointer transition-all">İzle</button>
