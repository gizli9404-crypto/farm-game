/* Mağaza Ana Konteynerı */
.shop-container {
    background: linear-gradient(135deg, #0a0f1d 0%, #050b14 100%);
    border: 2px solid #00ffcc;
    box-shadow: 0 0 20px rgba(0, 255, 204, 0.3), inset 0 0 15px rgba(0, 255, 204, 0.1);
    border-radius: 12px;
    padding: 20px;
    color: #fff;
    font-family: 'Courier New', Courier, monospace;
    position: relative;
    overflow: hidden;
}

/* Siber Dijital Yağmur / Arka Plan Efekti */
.shop-container::before {
    content: "010101 101010 001101 GPU_RIG_ACTIVE";
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    color: rgba(0, 255, 204, 0.03);
    font-size: 12px;
    line-height: 1;
    pointer-events: none;
    z-index: 0;
    white-space: pre-wrap;
    overflow: hidden;
}

/* Ekran Kartı Mağaza Kartları */
.gpu-shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px;
    position: relative;
    z-index: 1;
    margin-top: 15px;
}

.gpu-card-item {
    background: rgba(10, 25, 40, 0.85);
    border: 1px solid #00bfff;
    border-radius: 8px;
    padding: 15px;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 0 0 10px rgba(0, 191, 255, 0.2);
}

.gpu-card-item:hover {
    transform: translateY(-3px);
    border-color: #00ffcc;
    box-shadow: 0 0 15px rgba(0, 255, 204, 0.5);
}

.gpu-card-item h4 {
    color: #00ffcc;
    margin-bottom: 5px;
    font-size: 16px;
    text-shadow: 0 0 5px rgba(0, 255, 204, 0.5);
}

.gpu-card-item p {
    font-size: 13px;
    color: #a0aec0;
    margin-bottom: 10px;
}

/* Satın Al Butonu (Neon Efektli) */
.gpu-buy-btn {
    background: linear-gradient(90deg, #007bff, #00ffcc);
    border: none;
    color: #050b14;
    font-weight: bold;
    padding: 8px 15px;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
    transition: 0.2s;
    box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);
}

.gpu-buy-btn:hover {
    background: linear-gradient(90deg, #00ffcc, #007bff);
    box-shadow: 0 0 15px rgba(0, 255, 204, 0.8);
}
